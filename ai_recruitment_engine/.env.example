# --- LLM provider: ollama (default, free/local) | openai | anthropic ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3:8b
OLLAMA_HOST=http://localhost:11434

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Embeddings (local, always free) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=resumes

# --- Database: leave blank to use local SQLite at data/app.db ---
DATABASE_URL=
